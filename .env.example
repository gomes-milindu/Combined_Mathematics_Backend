# ===========================================================
# Combined Mathematics Backend — Environment Variables
# ===========================================================
# Copy this file to .env and fill in the values.

# -----------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------

# MongoDB connection string
MONGODB_URI=


# JWT signing secret (use a long random string)
JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------
# OPTIONAL (defaults shown)
# -----------------------------------------------------------

# Server port
PORT=8080

# Node environment (development | production)
NODE_ENV=development

# JWT token expiry duration (e.g. 1d, 12h, 30m)
JWT_EXPIRES_IN=1d

# bcrypt cost factor for password hashing
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------
# SUPABASE (optional — QR code upload disabled if missing)
# -----------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------
# SMS GATEWAY (optional — SMS notifications disabled if missing)
# -----------------------------------------------------------

QUICKSEND_SENDER_ID=
QUICKSEND_EMAIL=
QUICKSEND_API_KEY=

# -----------------------------------------------------------
# LOGGING — production only
# -----------------------------------------------------------

LOGTAIL_SOURCE_TOKEN=
